# Variables Supabase (obligatoires)
NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta_cle_anon_publique

# Optionnel — pour les webhooks serveur (phase paiement)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — génération de questions QCM + explication des erreurs
GEMINI_API_KEY=

# Google Cloud Text-to-Speech — voix des personnages du chat vocal (Kora, Amara, Kwame, Sango)
GOOGLE_TTS_API_KEY=

# Firebase Cloud Messaging — notifications push (web + mobile)
# Config publique (web), depuis Firebase Console > Paramètres du projet > Général > App web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Clé VAPID, depuis Cloud Messaging > Certificats push web
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Compte de service (serveur, jamais exposé), depuis Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
